# Job Radar, local configuration. Copy to .env and fill in.
# Everything is optional except the first block: an empty value means the feature is off,
# and the rest of the radar keeps working. On the Cloudflare worker these come from
# secrets and wrangler.local.jsonc instead, see DEPLOY.md.

# ---------------------------------------------------------------------------
# The minimum
# ---------------------------------------------------------------------------

# Your email. Goes into the User-Agent of every request, so a site owner can see who
# is visiting. Fill in a real one: empty turns into "unknown" in their logs.
USER_AGENT_CONTACT=

# Anthropic key for vacancy classification. Without it vacancies are still collected
# and scored by keywords alone, and every one lands in manual review. Alternative:
# LLM_PROVIDER=workers-ai below.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# API password. Empty means local mode with no check. Mandatory on a deployed worker:
# without it the radar and its contacts database are open to the whole internet.
# The same string goes into the extension popup.
RADAR_TOKEN=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------

ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# First paragraph of a letter: a stronger model, calls are few and a human reads the text
OUTREACH_MODEL=claude-sonnet-5
# Verdict on a company on the Studios page. Empty means the same as OUTREACH_MODEL.
VERDICT_MODEL=

# Who classifies vacancies: anthropic or workers-ai. workers-ai is paid from the
# Cloudflare plan's neuron quota instead of a per-token bill.
LLM_PROVIDER=anthropic
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Daily ceiling on model calls. Once reached: a WARN, and the rest waits for manual review.
LLM_DAILY_CALL_LIMIT=500
WORKERS_AI_DAILY_CALL_LIMIT=5000
# How many characters of a vacancy go into the model
LLM_MAX_INPUT_CHARS=8000

# Optional AI Gateway in front of Anthropic: a cache, a hard spend limit and a log of
# every request. Empty means direct calls. Format:
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/anthropic
ANTHROPIC_BASE_URL=
# Only if authentication is enabled on the gateway. Without it the gateway answers 401
# before the model, which looks as if the model were down.
AI_GATEWAY_TOKEN=

# Workers AI outside the worker (company vectors, and classification with
# LLM_PROVIDER=workers-ai). Not needed on the worker, the AI binding works there.
# Token: dash.cloudflare.com, My Profile, API Tokens, permissions Workers AI Read and Run.
# The names are CF_AI_* on purpose: wrangler reads .env too, and a CLOUDFLARE_API_TOKEN
# here would replace your wrangler login with a token that can only run models.
CF_AI_ACCOUNT_ID=
CF_AI_API_TOKEN=
AI_GATEWAY_ID=

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------

# gmail (default): OAuth, threads properly, and reads the mailbox to detect replies.
# resend: one HTTPS call with a key and a verified domain, sends only.
MAIL_PROVIDER=gmail
RESEND_API_KEY=

# Your name and address in From. Needed by both providers; with Resend the address
# must be on the domain you verified there. A letter with no name reads as a mailing.
GMAIL_FROM_NAME=
GMAIL_FROM_EMAIL=

# Gmail OAuth client from the Google Cloud console. Connect with `pnpm cli auth:gmail`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The refresh token lives in this file, never in the database: a database backup with
# it inside would be access to your mailbox.
GMAIL_TOKEN_PATH=data/.gmail-token.json
GMAIL_AUTH_PORT=53682

# ---------------------------------------------------------------------------
# Telegram: one summary on Monday and Thursday. `pnpm cli notify:check` finds the chat id.
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# off disables polling for bot commands, the summary still goes out
TELEGRAM_BOT=on

# ---------------------------------------------------------------------------
# Crawling. Keep it polite: these defaults are one request per domain per second.
# ---------------------------------------------------------------------------

HTTP_CONCURRENCY=4
HTTP_DOMAIN_DELAY_MS=1000
HTTP_TIMEOUT_MS=20000
HTTP_RETRIES=3

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------

SCORE_THRESHOLD=6
# A company contacted earlier comes back into the queue after this many days, if it has a new vacancy
RECONTACT_AFTER_DAYS=90
QUEUE_DAILY_LIMIT=10
# Page snapshots kept per company, older ones are cleaned up
SNAPSHOTS_PER_COMPANY=5
# Scoring rules file. Edits made on the Rules page are stored in the database and win.
SCORING_CONFIG=config/scoring.json

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

API_PORT=3000
# Address the API listens on. Loopback by default: local mode has no password, so 0.0.0.0
# would open the radar to everyone on the same network. Set RADAR_TOKEN if you change it.
API_HOST=127.0.0.1
# Interface address for links in Telegram
WEB_URL=http://localhost:5173
# Time zone of the schedule
TZ=Europe/Kyiv
# off disables the schedule, leaving only the API
SCHEDULER=on
LOG_LEVEL=info
DB_PATH=data/radar.db
