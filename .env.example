# Пароль до API. Порожній означає локальний режим без перевірки.
# Для задеплойованого воркера обовʼязковий: без нього радар відкритий усьому
# інтернету разом з базою контактів. Той самий рядок вписується в попап розширення.
RADAR_TOKEN=

# Anthropic, для класифікації (Етап 4)
ANTHROPIC_API_KEY=
# Порожнє означає прямий виклик Anthropic. Через шлюз AI Gateway зʼявляються кеш,
# жорсткий ліміт витрат і лог кожного запиту. Створюється в дашборді Cloudflare,
# AI, AI Gateway, кнопка Create Gateway, імʼя job-radar. Формат адреси:
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/anthropic
# Workers AI для векторів і класифікації поза Workers. На проді не потрібні:
# там працює біндінг AI. Токен: dash.cloudflare.com, My Profile, API Tokens,
# права Workers AI Read і Run.
#
# Імена саме такі, а не CLOUDFLARE_*: wrangler читає .env і бере CLOUDFLARE_API_TOKEN
# як свій ключ авторизації. Токен на самий Workers AI підміняв логін власника,
# і pnpm cf:migrate падав з 7403 "account is not authorized to access this service".
CF_AI_ACCOUNT_ID=
CF_AI_API_TOKEN=

# Імʼя шлюзу AI Gateway і токен, якщо в його налаштуваннях увімкнена автентифікація.
# Без токена шлюз відбиває запит з 401 ще до моделі, і збоку це виглядає так,
# ніби модель не відповідає.
AI_GATEWAY_ID=
AI_GATEWAY_TOKEN=

ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Перший абзац листа: окрема модель, бо викликів десятки, а текст читає людина
OUTREACH_MODEL=claude-sonnet-5
# Вердикт по компанії на сторінці Студії. Порожнє означає ту саму, що для листа.
VERDICT_MODEL=
# Хто класифікує вакансії: anthropic або workers-ai.
# workers-ai рахується нейронами платного плану Cloudflare, тобто окремого рахунку
# за токени немає. На Workers працює біндінгом, локально через CLOUDFLARE_* вище.
LLM_PROVIDER=anthropic
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Стеля викликів моделі на добу, при досягненні буде WARN і ручний перегляд.
# Для workers-ai діє окрема стеля: там виклики йдуть з квоти плану, а не з рахунку.
LLM_DAILY_CALL_LIMIT=500
WORKERS_AI_DAILY_CALL_LIMIT=5000
# Скільки символів вакансії йде в модель
LLM_MAX_INPUT_CHARS=8000

# Хто відправляє листи: gmail або resend.
#
# gmail це типовий варіант і єдиний, який уміє ще й читати скриньку, а саме на
# цьому тримається детекція відповідей. Але це OAuth, проєкт у Google Cloud і
# токен файлом на диску, тому на воркері він не працює.
#
# resend це один HTTPS-запит: ключ і підтверджений домен. Працює і на воркері,
# але скриньку не читає, тобто відповіді доведеться помічати руками.
MAIL_PROVIDER=gmail
RESEND_API_KEY=

# Розсилка з власної пошти. Без цих змінних інтерфейс працює, листи не йдуть.
# OAuth2, а не SMTP з паролем застосунку: без threadId неможливі ні детекція
# відповідей, ні коректне тредування фолоу-апів.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Твоє імʼя і пошта в полі From. Лист без імені читається як розсилка.
# Ці дві потрібні обом провайдерам: у Resend адреса має бути на домені,
# який ти в ньому підтвердив.
GMAIL_FROM_NAME=
GMAIL_FROM_EMAIL=
# Токен лежить окремим файлом, а не в базі: бекап бази з рефреш-токеном усередині
# це доступ до твоєї пошти в архіві.
GMAIL_TOKEN_PATH=data/.gmail-token.json
GMAIL_AUTH_PORT=53682

# Telegram (Етап 7)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HTTP
# Твоя пошта. Іде в User-Agent кожного запиту, щоб власник сайту бачив, хто ходить.
# Впиши справжню: порожня перетворюється на "unknown", і це видно в їхніх логах.
USER_AGENT_CONTACT=
HTTP_CONCURRENCY=4
HTTP_DOMAIN_DELAY_MS=1000

# Пайплайн
SCORE_THRESHOLD=6
RECONTACT_AFTER_DAYS=90
QUEUE_DAILY_LIMIT=10
# Скільки знімків сторінки тримати на компанію, старіші чистяться.
SNAPSHOTS_PER_COMPANY=5

# Сервер і планувальник
API_PORT=3000
# Адреса інтерфейсу для посилань у телеграмі. Задеплоєний варіант: адреса воркера.
WEB_URL=http://localhost:5173
TZ=Europe/Kyiv
# SCHEDULER=off вимикає cron, лишаючи тільки API
SCHEDULER=on
# TELEGRAM_BOT=off вимикає полінг команд бота, сповіщення далі працюють
TELEGRAM_BOT=on

# Логи
LOG_LEVEL=info
LOG_FILE=logs/radar.log
DB_PATH=data/radar.db
