# Anthropic, для класифікації (Етап 4)
ANTHROPIC_API_KEY=
# Порожнє означає прямий виклик Anthropic. Через шлюз AI Gateway зʼявляються кеш,
# жорсткий ліміт витрат і лог кожного запиту. Створюється в дашборді Cloudflare,
# AI, AI Gateway, кнопка Create Gateway, імʼя job-radar. Формат адреси:
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/anthropic
# Workers AI для векторів і класифікації поза Workers. На проді не потрібні:
# там працює біндінг AI. Токен: dash.cloudflare.com, My Profile, API Tokens,
# права Workers AI Read і Run.
#
# Імена саме такі, а не CLOUDFLARE_*: wrangler читає .env і бере CLOUDFLARE_API_TOKEN
# як свій ключ авторизації. Токен на самий Workers AI підміняв логін власника,
# і pnpm cf:migrate падав з 7403 "account is not authorized to access this service".
CF_AI_ACCOUNT_ID=
CF_AI_API_TOKEN=

ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Перший абзац листа: окрема модель, бо викликів десятки, а текст читає людина
OUTREACH_MODEL=claude-sonnet-5
# Хто класифікує вакансії: anthropic або workers-ai.
# workers-ai рахується нейронами платного плану Cloudflare, тобто окремого рахунку
# за токени немає. На Workers працює біндінгом, локально через CLOUDFLARE_* вище.
LLM_PROVIDER=anthropic
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Стеля викликів моделі на добу, при досягненні буде WARN і ручний перегляд.
# Для workers-ai діє окрема стеля: там виклики йдуть з квоти плану, а не з рахунку.
LLM_DAILY_CALL_LIMIT=500
WORKERS_AI_DAILY_CALL_LIMIT=5000
# Скільки символів вакансії йде в модель
LLM_MAX_INPUT_CHARS=8000

# Telegram (Етап 7)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HTTP
USER_AGENT_CONTACT=you@example.com
HTTP_CONCURRENCY=4
HTTP_DOMAIN_DELAY_MS=1000

# Пайплайн
SCORE_THRESHOLD=6
RECONTACT_AFTER_DAYS=90
QUEUE_DAILY_LIMIT=10

# Сервер і планувальник
API_PORT=3000
# локально: http://localhost:5173
WEB_URL=https://job-radar.example.workers.dev
TZ=Europe/Kyiv
# SCHEDULER=off вимикає cron, лишаючи тільки API
SCHEDULER=on
# TELEGRAM_BOT=off вимикає полінг команд бота, сповіщення далі працюють
TELEGRAM_BOT=on

# Логи
LOG_LEVEL=info
LOG_FILE=logs/radar.log
DB_PATH=data/radar.db
