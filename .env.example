# API password. Empty means local mode with no check.
# Mandatory for a deployed worker: without it the radar is open to the whole
# internet along with the contacts database. The same string goes into the extension popup.
RADAR_TOKEN=

# Anthropic, for classification (Stage 4)
ANTHROPIC_API_KEY=
# Empty means a direct call to Anthropic. Through the AI Gateway you get a cache,
# a hard spend limit and a log of every request. Created in the Cloudflare dashboard,
# AI, AI Gateway, Create Gateway button, name job-radar. Address format:
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/anthropic
# Workers AI for vectors and classification outside Workers. Not needed in prod:
# the AI binding works there. Token: dash.cloudflare.com, My Profile, API Tokens,
# Workers AI Read and Run permissions.
#
# The names are exactly these, not CLOUDFLARE_*: wrangler reads .env and takes
# CLOUDFLARE_API_TOKEN as its own auth key. A token scoped to just Workers AI replaced
# the owner's login, and pnpm cf:migrate failed with 7403 "account is not authorized to access this service".
CF_AI_ACCOUNT_ID=
CF_AI_API_TOKEN=

# AI Gateway name and token, if authentication is enabled in its settings.
# Without the token the gateway bounces the request with 401 before it reaches the model,
# and from the outside it looks like the model is not responding.
AI_GATEWAY_ID=
AI_GATEWAY_TOKEN=

ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# First paragraph of the letter: a separate model, because there are dozens of calls and a human reads the text
OUTREACH_MODEL=claude-sonnet-5
# Verdict on a company on the Studios page. Empty means the same model used for the letter.
VERDICT_MODEL=
# Who classifies vacancies: anthropic or workers-ai.
# workers-ai is billed in neurons from the paid Cloudflare plan, so there is no
# separate token bill. On Workers it works through the binding, locally through CLOUDFLARE_* above.
LLM_PROVIDER=anthropic
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Daily ceiling on model calls, once reached it is a WARN and a manual review.
# workers-ai has a separate ceiling: those calls come out of the plan quota, not a token bill.
LLM_DAILY_CALL_LIMIT=500
WORKERS_AI_DAILY_CALL_LIMIT=5000
# How many characters of a vacancy go into the model
LLM_MAX_INPUT_CHARS=8000

# Who sends the letters: gmail or resend.
#
# gmail is the default and the only one that can also read the mailbox, and reply
# detection rests entirely on that. But it is OAuth, a Google Cloud project and a
# token stored as a file on disk, so it does not work on the worker.
#
# resend is a single HTTPS request: a key and a verified domain. Works on the worker
# too, but does not read the mailbox, so replies have to be marked by hand.
MAIL_PROVIDER=gmail
RESEND_API_KEY=

# Sending from your own mailbox. Without these variables the interface still works,
# letters just do not go out. OAuth2, not SMTP with an app password: without a threadId
# neither reply detection nor correct follow-up threading is possible.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your name and email in the From field. A letter with no name reads as a mass mailing.
# Both of these are needed by either provider: with Resend the address must be on the
# domain you verified in it.
GMAIL_FROM_NAME=
GMAIL_FROM_EMAIL=
# The token is kept in its own file, not in the database: a database backup with the
# refresh token inside it means access to your mailbox from the archive.
GMAIL_TOKEN_PATH=data/.gmail-token.json
GMAIL_AUTH_PORT=53682

# Telegram (Stage 7)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HTTP
# Your email. Goes into the User-Agent of every request, so a site owner can see who is visiting.
# Fill in a real one: empty turns into "unknown", and it shows up that way in their logs.
USER_AGENT_CONTACT=
HTTP_CONCURRENCY=4
HTTP_DOMAIN_DELAY_MS=1000

# Pipeline
SCORE_THRESHOLD=6
RECONTACT_AFTER_DAYS=90
QUEUE_DAILY_LIMIT=10
# How many page snapshots to keep per company, older ones get cleaned up.
SNAPSHOTS_PER_COMPANY=5

# Server and scheduler
API_PORT=3000
# Interface address for links in Telegram. Deployed variant: the worker's address.
WEB_URL=http://localhost:5173
TZ=Europe/Kyiv
# SCHEDULER=off disables cron, leaving only the API
SCHEDULER=on
# TELEGRAM_BOT=off disables polling for bot commands, notifications keep working
TELEGRAM_BOT=on

# Logs
LOG_LEVEL=info
LOG_FILE=logs/radar.log
DB_PATH=data/radar.db
