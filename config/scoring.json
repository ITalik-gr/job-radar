    "_kindWeights": "Weight by company kind. A startup without catalog tags otherwise scores almost zero and does not clear the threshold, even though it is worth writing to. Outstaff and product are penalized: the former has a middleman, the latter does not respond to cold outreach.",
    "kindWeights": {
      "startup": 3,
      "design": 2,
      "studio": 2,
      "outstaff": -3,
      "product": -5,
      "unknown": 0
    },
    "_stale": "Penalty for a dead site. An agency with a copyright year from two years ago and no fresh posts is not hiring and will not reply, and a letter there is a wasted evening.",
    "stale": {
      "copyrightYearsBehind": 2,
      "copyrightPenalty": -4,
      "blogSilentDays": 540,
      "blogPenalty": -2
    },
    "hasCareersPage": 2,
    "hasOpenVacancies": 3,
    "reputation": {
      "_": "Reputation in the catalog. A studio with reviews genuinely works with clients, an empty card is often abandoned.",
      "goodRating": 4.5,
      "goodRatingBonus": 2,
      "weakRating": 4,
      "weakRatingPenalty": -1,
      "reviewsFrom": 5,
      "reviewsBonus": 1,
      "noReviewsPenalty": -1
    },
    "hourlyRateBonus": {
      "_": "An agency's rate hints at budget. Very cheap ones will not pay, very expensive ones will not take outside work.",
      "$25 - $49 / hr": 1,
      "$50 - $99 / hr": 3,
      "$100 - $149 / hr": 2,
      "$150 - $199 / hr": 0,
      "$200 - $300 / hr": -2
    },
    "_web": "YC and catalog tags that show whether this is a web product. The owner is a frontend developer, so SaaS and developer tools are his kind of work, while a robotics factory or biotech hires completely different people, and a letter there is pointless for both sides."
  },
