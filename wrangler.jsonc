{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "job-radar",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Фронт віддається як статика тим самим воркером, окремий Pages не потрібен.
	"assets": {
		"directory": "web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		/*
		 * Без цього рядка навігація браузера на /api/* не доходить до воркера.
		 * SPA-фолбек віддає index.html будь-якому запиту з Accept: text/html,
		 * тому curl бачив JSON, а браузер на тій самій адресі бачив інтерфейс.
		 * Через це мовчки ламався і колбек Google: він приходить саме навігацією.
		 */
		"run_worker_first": ["/api/*"]
	},
	// Workers AI: вектори компаній і, за LLM_PROVIDER=workers-ai, класифікація вакансій.
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "job-radar",
			"database_id": "your-d1-database-id",
			"migrations_dir": "src/db/migrations"
		},
		{
			"binding": "job_radar",
			"database_name": "job-radar",
			"database_id": "your-d1-database-id"
		}
	],
	"triggers": {
		"crons": [
			"0 */6 * * *",
			"0 4 * * 1",
			"0 5 * * 2",
			"0 10 * * *",
			"0 18 * * *",
			// Розсилка. Час у Cron Triggers завжди UTC: 06:30 тут це 09:30 за Києвом.
			"5 * * * *",
			"30 6 * * *"
		]
	},
	"vars": {
		"ANTHROPIC_MODEL": "claude-haiku-4-5-20251001",
		// Перший абзац листа. Сильніша модель: викликів десятки, а текст читає людина.
		"OUTREACH_MODEL": "claude-sonnet-5",
		// anthropic | workers-ai. Друге це включена квота платного плану замість рахунку за токени.
		"LLM_PROVIDER": "anthropic",
		"WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		// AI Gateway: у ньому видно кожен виклик моделі, його вартість і кеш.
		// Без цих двох змінних запити йдуть повз шлюз, і в ньому чесні нулі.
		"CF_AI_ACCOUNT_ID": "your-cloudflare-account-id",
		"AI_GATEWAY_ID": "job-radar",
		// Куди Google повертає код підключення пошти. Має збігатись з консоллю Google.
		"GMAIL_REDIRECT_URI": "https://job-radar.example.workers.dev/api/gmail/callback",
		"GMAIL_FROM_NAME": "Alex Example"
	},
	"observability": {
		"enabled": true
	}
}