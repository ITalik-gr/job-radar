{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "job-radar",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Фронт віддається як статика тим самим воркером, окремий Pages не потрібен.
	"assets": {
		"directory": "web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		/*
		 * Без цього рядка навігація браузера на /api/* не доходить до воркера.
		 * SPA-фолбек віддає index.html будь-якому запиту з Accept: text/html,
		 * тому curl бачив JSON, а браузер на тій самій адресі бачив інтерфейс.
		 * Через це мовчки ламався і колбек Google: він приходить саме навігацією.
		 */
		"run_worker_first": ["/api/*"]
	},
	// Workers AI: вектори компаній і, за LLM_PROVIDER=workers-ai, класифікація вакансій.
	"ai": {
		"binding": "AI"
	},
	/*
	 * No database_id on purpose: the schema marks it optional, and wrangler binds
	 * the database by name at deploy time. That keeps one person's database out of
	 * everyone else's checkout, which matters now that this repo is meant to be
	 * cloned. Create yours once with `wrangler d1 create job-radar`, or rename it
	 * here and create it under that name.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "job-radar",
			"migrations_dir": "src/db/migrations"
		},
		{
			"binding": "job_radar",
			"database_name": "job-radar"
		}
	],
	"triggers": {
		"crons": [
			"0 */6 * * *",
			"0 4 * * 1",
			"0 5 * * 2",
			// Telegram summary, Monday and Thursday. UTC: 07:00 here is 10:00 in Kyiv.
			"0 7 * * MON,THU",
			// Розсилка. Час у Cron Triggers завжди UTC: 06:30 тут це 09:30 за Києвом.
			"5 * * * *",
			"30 6 * * *"
		]
	},
	"vars": {
		"ANTHROPIC_MODEL": "claude-haiku-4-5-20251001",
		// Перший абзац листа. Сильніша модель: викликів десятки, а текст читає людина.
		"OUTREACH_MODEL": "claude-sonnet-5",
		// anthropic | workers-ai. Друге це включена квота платного плану замість рахунку за токени.
		"LLM_PROVIDER": "anthropic",
		"WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
	},
	/*
	 * Everything that identifies a person lives outside this file, as secrets:
	 * `wrangler secret put NAME`. Secrets survive a deploy, plain vars here do not,
	 * so putting them in this list would mean every fork overwriting them with the
	 * author's values on the next push.
	 *
	 * Set these after the first deploy:
	 *   RADAR_TOKEN          password for the API, without it the worker is open to anyone
	 *   ANTHROPIC_API_KEY    classification and the company verdict
	 *   CF_AI_ACCOUNT_ID     your Cloudflare account, only needed for AI Gateway
	 *   AI_GATEWAY_ID        gateway name, same
	 *   GMAIL_FROM_NAME      the name letters are signed with
	 *   GMAIL_REDIRECT_URI   https://<your-worker>/api/gmail/callback, must match Google console
	 */
	"observability": {
		"enabled": true
	}
}