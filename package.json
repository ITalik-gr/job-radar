{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "deploy": "pnpm build:web && wrangler deploy",
    "cf:dev": "wrangler dev",
    "cf:migrate": "wrangler d1 migrations apply job-radar --remote",
    "cf:migrate:local": "wrangler d1 migrations apply job-radar --local",
    "cf:build": "pnpm build:web",
    "cf:deploy": "wrangler deploy",
    "cf:tail": "wrangler tail job-radar --format pretty",
    "cf:doctor": "tsx src/cli/index.ts doctor"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@hono/node-server": "^2.1.1",
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "better-sqlite3": "^12.2.0",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.2",
    "grammy": "^1.46.0",
    "hono": "^4.13.5",
    "lucide-react": "^1.39.0",
    "node-cron": "^4.6.0",
    "p-limit": "^6.2.0",
    "p-retry": "^6.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "robots-parser": "^3.0.1",
    "undici": "^7.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "domhandler": "^5.0.3",
    "drizzle-kit": "^0.31.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^3.0.4",
    "wrangler": "^4.128.0"
  },
  "packageManager": "pnpm@11.18.0"
}
